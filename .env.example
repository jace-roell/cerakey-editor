# Copy this file to `.env` and fill in the value. `.env` is git-ignored.
#
# The passphrase lab.cerakey.com uses to encrypt and decrypt exported
# keyboard_config.json files. It is not included in this project; see the README.
#
# Only needed for opening or exporting *encrypted* config files. Reading from and
# writing to the keyboard, and plain (decrypted) JSON files, work without it.
VITE_CERAKEY_PASSPHRASE=
